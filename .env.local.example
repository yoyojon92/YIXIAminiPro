# 邑夏小程序环境变量配置模板
# 复制此文件为 .env.local 并填入真实值

# ===================
# 微信小程序配置
# ===================
# 微信小程序 AppID
WECHAT_APP_ID=your_wechat_app_id

# 微信小程序 AppSecret（仅后端使用，请勿泄露）
WECHAT_APP_SECRET=your_wechat_app_secret

# ===================
# 项目域名配置
# ===================
# 后端 API 域名（生产环境）
API_DOMAIN=https://api.yixia-brand.com

# 前端域名
WEB_DOMAIN=https://yixia-brand.com

# CDN 域名
CDN_DOMAIN=https://cdn.yixia-brand.com

# ===================
# 数据库配置
# ===================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=yixia
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password

# ===================
# 微信支付配置
# ===================
# 商户号
WECHAT_PAY_MCH_ID=your_merchant_id

# 支付密钥
WECHAT_PAY_API_KEY=your_payment_api_key

# 支付证书路径
WECHAT_PAY_CERT_PATH=/path/to/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=/path/to/apiclient_key.pem

# ===================
# 对象存储配置
# ===================
# TOS endpoint
TOS_ENDPOINT=https://tos.yixia-brand.com

# TOS bucket
TOS_BUCKET=yixia-assets

# TOS access key
TOS_ACCESS_KEY=your_tos_access_key

# TOS secret key
TOS_SECRET_KEY=your_tos_secret_key

# ===================
# 其他配置
# ===================
# JWT 密钥
JWT_SECRET=your_jwt_secret_key

# Session 加密密钥
SESSION_SECRET=your_session_secret

# 短信验证码密钥（腾讯云）
SMS_SECRET_ID=your_sms_secret_id
SMS_SECRET_KEY=your_sms_secret_key
