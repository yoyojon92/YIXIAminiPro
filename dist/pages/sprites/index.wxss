.sprites-page{background:-webkit-linear-gradient(315deg,#1a1a2e,#16213e 50%,#0f3460);background:linear-gradient(135deg,#1a1a2e,#16213e 50%,#0f3460);min-height:100vh;padding-bottom:40rpx}.navbar{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;background:-webkit-gradient(linear,left top,left bottom,from(rgba(26,26,46,.95)),to(transparent));background:-webkit-linear-gradient(top,rgba(26,26,46,.95),transparent);background:linear-gradient(180deg,rgba(26,26,46,.95),transparent);justify-content:space-between;padding:60rpx 30rpx 20rpx;position:-webkit-sticky;position:sticky;top:0;z-index:100}.navbar-back{-webkit-align-items:center;background:hsla(0,0%,100%,.1);border-radius:50%;display:-webkit-flex;display:-ms-flexbox;display:flex;height:40rpx;width:40rpx;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;-webkit-backdrop-filter:blur(10rpx);backdrop-filter:blur(10rpx);justify-content:center}.navbar-title{color:#fff;font-size:36rpx;font-weight:600;letter-spacing:4rpx}.navbar-placeholder{width:40rpx}.header{padding:30rpx 30rpx 50rpx;text-align:center}.header-title{background:-webkit-gradient(linear,left top,right top,from(#ff6b9d),color-stop(#c44569),to(#ff6b9d));background:-webkit-linear-gradient(left,#ff6b9d,#c44569,#ff6b9d);background:linear-gradient(90deg,#ff6b9d,#c44569,#ff6b9d);-webkit-background-clip:text;background-clip:text;color:#fff;display:block;font-size:48rpx;font-weight:700;margin-bottom:16rpx;-webkit-text-fill-color:transparent}.header-desc{color:hsla(0,0%,100%,.6);display:block;font-size:28rpx}.sprites-grid{display:grid;grid-gap:30rpx;gap:30rpx;grid-template-columns:repeat(2,1fr);padding:0 30rpx}.sprite-card{-webkit-backdrop-filter:blur(10rpx);backdrop-filter:blur(10rpx);background:hsla(0,0%,100%,.05);border:1rpx solid hsla(0,0%,100%,.1);border-radius:30rpx;overflow:hidden;-webkit-transition:-webkit-transform .3s ease,-webkit-box-shadow .3s ease;transition:-webkit-transform .3s ease, -webkit-box-shadow .3s ease;transition:transform .3s ease, box-shadow .3s ease;transition:transform .3s ease, box-shadow .3s ease, -webkit-transform .3s ease, -webkit-box-shadow .3s ease}.sprite-card:active{-webkit-transform:scale(.98);-ms-transform:scale(.98);transform:scale(.98)}.sprite-image-wrapper{height:300rpx;overflow:hidden;width:100%}.sprite-image{height:100%;width:100%}.sprite-info{padding:20rpx}.sprite-title{color:#fff;display:block;font-size:28rpx;font-weight:600;margin-bottom:8rpx}.sprite-name{color:hsla(0,0%,100%,.7);display:block;font-size:24rpx;margin-bottom:12rpx}.sprite-product{color:#ff6b9d;display:block;font-size:22rpx}.footer{margin-top:60rpx;padding:0 30rpx;text-align:center}.footer-text{color:hsla(0,0%,100%,.4);font-size:24rpx}