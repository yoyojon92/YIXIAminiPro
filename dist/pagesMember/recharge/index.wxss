.recharge-page{background:#f5f5f5;min-height:100vh;padding:24rpx}.balance-card{background:-webkit-linear-gradient(315deg,#ff6b00,#ff8c00);background:linear-gradient(135deg,#ff6b00,#ff8c00);border-radius:24rpx;margin-bottom:24rpx}.balance-card__content{padding:32rpx}.balance-card__header{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;gap:12rpx;margin-bottom:16rpx}.balance-card__title{color:#fff;font-size:32rpx;font-weight:500}.balance-card__amount{color:#fff;display:block;font-size:56rpx;font-weight:700;margin-bottom:8rpx;text-align:center}.balance-card__tip{color:hsla(0,0%,100%,.8);display:block;font-size:24rpx;text-align:center}.buy-btn{-webkit-align-items:center;background:-webkit-linear-gradient(315deg,#ff6b00,#ff8c00);background:linear-gradient(135deg,#ff6b00,#ff8c00);border-radius:16rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;height:88rpx;width:100%;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;gap:8rpx;justify-content:center;margin-bottom:24rpx}.buy-btn__text{color:#fff;font-size:32rpx;font-weight:500}.card-list{background:#fff;border-radius:24rpx;padding:24rpx}.card-list__title{color:#333;display:block;font-size:32rpx;font-weight:500;margin-bottom:16rpx}.recharge-card{background:#fafafa;border-radius:16rpx;margin-bottom:16rpx;padding:24rpx}.recharge-card:last-child{margin-bottom:0}.recharge-card__header{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;-webkit-align-items:center;justify-content:space-between;-ms-flex-align:center;align-items:center;margin-bottom:16rpx}.recharge-card__name{color:#333;font-size:30rpx;font-weight:500}.card-status{border-radius:8rpx;font-size:22rpx;padding:4rpx 12rpx}.card-status--active{background:rgba(7,193,96,.1);color:#07c160}.card-status--expired{background:rgba(255,107,0,.1);color:#ff6b00}.card-status--used{background:hsla(0,0%,60%,.1);color:#999}.recharge-card__info{margin-bottom:16rpx}.recharge-card__balance{color:#ff6b00;display:block;font-size:32rpx;font-weight:700;margin-bottom:4rpx}.recharge-card__original{color:#999;display:block;font-size:24rpx}.recharge-card__footer{border-top:1rpx solid #eee;padding-top:16rpx}.recharge-card__validity{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;gap:8rpx}.recharge-card__validity-text{color:#999;font-size:24rpx}