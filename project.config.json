{
  "miniprogramRoot": "./dist",
  "cloudfunctionRoot": "./cloudfunctions/",
  "projectname": "yixia-mini-program",
  "description": "邑夏果酒果汁小程序 - 基于微信云开发",
  "appid": "YOUR_WECHAT_APPID", // TODO: 替换为你的微信小程序 AppID
  "setting": {
    "urlCheck": true,
    "es6": false,
    "enhance": false,
    "compileHotReLoad": false,
    "postcss": false,
    "minified": false
  },
  "compileType": "miniprogram",
  "packOptions": { "ignore": [{ "type": "folder", "value": "./assets" }] }
}
